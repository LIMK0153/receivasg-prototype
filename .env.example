# Copy to .env and fill in. TESTNET ONLY: never put a key that holds real funds here.
DEPLOYER_PRIVATE_KEY=0xyour_testnet_private_key
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: verify contract source on Etherscan after deploying
ETHERSCAN_API_KEY=
# ETH sent to each generated demo wallet for gas (default 0.01)
DEMO_GAS_ETH=0.01
# Set to 0 to skip the three background invoices (saves gas)
SEED_MARKET=1
# Offline only: use the bundled solc compiler instead of downloading it
# USE_LOCAL_SOLC=1
